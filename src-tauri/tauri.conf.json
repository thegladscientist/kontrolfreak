{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontrolfreak",
  "version": "0.1.0",
  "identifier": "dev.kontrolfreak.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kontrolfreak",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Modular low-latency studio router for control signals, hardware, NDI video, and depth sensors.",
    "longDescription": "Kontrolfreak is a modular, low-latency desktop studio for routing OSC, MIDI, RTPMIDI, WebSockets, UDP, HID hardware, RGB camera CV, NDI video streams, and crash-isolated depth sensors.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
